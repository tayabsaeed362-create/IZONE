{
  "name": "izone",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "description": "iZone by Haider — Smart Retail Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:pos": "turbo run dev --filter=@izone/pos",
    "dev:storefront": "turbo run dev --filter=@izone/storefront",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@izone/database",
    "db:migrate": "turbo run db:migrate --filter=@izone/database",
    "db:seed": "turbo run db:seed --filter=@izone/database",
    "db:clear": "cd packages/database && npx tsx src/clear-inventory.ts",
    "db:dev": "tsx packages/database/src/dev-db.ts",
    "db:studio": "cd packages/database && npx prisma studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "fake-indexeddb": "^6.2.6",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
